
from pathlib import Path
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
sns.set_style("whitegrid")

#Get the project folder
BASE_DIR = Path(__file__).resolve().parent.parent

#Get the project folder
products = pd.read_csv(BASE_DIR / "cleaned_data" / "products_cleaned.csv")
orders = pd.read_csv(BASE_DIR / "cleaned_data" / "orders_cleaned.csv")
customers = pd.read_csv(BASE_DIR / "cleaned_data" / "customers_cleaned.csv")

#Merge the datasets
sales = orders.merge(products, on="product_id")
sales= sales.merge(customers, left_on="customer_id", right_on="id")

#TOTAL REVENUE
total_revenue = orders["amount_paid"].sum()
print("\nTotal Revenue")
print(total_revenue)


#TOTAL NO OF ORDERS
total_no_orders = len(orders)
print("\nTotal Orders:", total_no_orders)


#AVERAGE ORDER VALUE
average_order_value = orders["amount_paid"].mean()
print("\nAverage Order Value:")
print(average_order_value)

#HIGHEST ORDER VALUE
highest_order_value = orders["amount_paid"].max()
print("Highest Order Value:", highest_order_value)

#LOWEST ORDER VALUE
lowest_order_value = orders["amount_paid"].min()
print("Lowest Order Value:", lowest_order_value)

#TOP 5 MOST PURCHASED PRODUCTS
top_products = (
    sales.groupby("product_name")["quantity_purchased"]
    .sum().sort_values(ascending=False)
    .head(5)
)
print("Top Products:", top_products)

#WHICH PRODUCT CATEGORY GENERATES THE HIGHEST REVENUE?
category_revenue = (
    sales.groupby("category")["amount_paid"]
    .sum().sort_values(ascending=False)
)
print(category_revenue)

#TOP 5 CUSTOMERS BY AMOUNT SPENT
top_5_customers = (
    sales.groupby("name")["amount_paid"]
    .sum().sort_values(ascending=False)
    .head()
)
print(top_5_customers)

#MONTHLY REVENUE TREND
#convert order_date to datetime
sales["order_date"] = pd.to_datetime(sales["order_date"])
#Extract month and year from order_date
sales["year"] = sales["order_date"].dt.year
sales["month"] = sales["order_date"].dt.month
#Group by month and calculate total revenue
monthly_revenue = (
    sales.groupby(["year", "month"])["amount_paid"]
    .sum()
    .reset_index()
)
print(monthly_revenue)

#CUSTOMER WHO PURCHASED THE HIGHEST QUANTITY
top_customer = (
    sales.groupby("name")["quantity_purchased"]
    .sum()
    .sort_values(ascending=False)
    .head(1)
)
print(top_customer)

#VISUALIZATION
#create a year-month column
sales["year_month"] = sales["order_date"].dt.to_period("M").astype(str)
#cal monthly revenue
monthly_revenue = (
    sales.groupby("year_month")["amount_paid"]
    .sum()
    .reset_index()
)
#plot the charts
plt.figure(figsize=(12,6))

sns.lineplot(
    data=monthly_revenue,
    x="year_month",
    y="amount_paid",
    marker="o"
)

plt.title("Monthly Revenue Trend")
plt.xlabel("Month")
plt.ylabel("Revenue")
plt.xticks(rotation=45)

plt.tight_layout()
plt.savefig("visuals/monthly_revenue_trend.png", dpi=300, bbox_inches="tight")
plt.show()

#Top 10 Most Purchased Products
top_products = (
    sales.groupby("product_name")["quantity_purchased"]
    .sum()
    .sort_values(ascending=False)
    .head(10)
)

plt.figure(figsize=(12,6))
sns.barplot(
    x=top_products.values,
    y=top_products.index
)

plt.title("Top 10 Most Purchased Products")
plt.xlabel("Total Quantity Purchased")
plt.ylabel("Product Name")

plt.tight_layout()
plt.savefig("visuals/top_10_products.png", dpi=300)
plt.show()

#TOTAL 5 PRODUCT CATEGORIES BY REVENUE
top_categories = (
    sales.groupby("category")["amount_paid"]
    .sum().sort_values(ascending=False)
    .head(5)
)
plt.figure(figsize=(10,6))

sns.barplot(
    x=top_categories.values,
    y=top_categories.index
)

plt.title("Top 5 Product Categories by Revenue")
plt.xlabel("Revenue")
plt.ylabel("Category")

plt.tight_layout()

plt.savefig("visuals/top_5_categories_revenue.png", dpi=300, bbox_inches="tight")

plt.show()

#TOP 5 CUSTOMERS BY AMOUNT SPENT
top_customers = (
    sales.groupby("name")["amount_paid"]
    .sum()
    .sort_values(ascending=False)
    .head(5)
)
plt.figure(figsize=(10,6))

sns.barplot(
    x=top_customers.values,
    y=top_customers.index
)

plt.title("Top 5 Customers by Amount Spent")
plt.xlabel("Amount Spent")
plt.ylabel("Customer")

plt.tight_layout()

plt.savefig(
    "visuals/top_5_customers_amount_spent.png",
    dpi=300,
    bbox_inches="tight"
)

plt.show()
plt.close()

#REVENUE SHARE BY CATEGORY
category_revenue = (
    sales.groupby("category")["amount_paid"]
    .sum()
)

plt.figure(figsize=(8,8))

plt.pie(
    category_revenue.values,
    labels=category_revenue.index,
    autopct="%1.1f%%",
    startangle=90
)

plt.title("Revenue Share by Product Category")

plt.savefig("visuals/category_revenue_pie.png", dpi=300, bbox_inches="tight")

plt.show()
